{
  "default": {
    "require": [
      "src/hooks/hooks.ts",
      "src/steps/**/*.ts"
    ],
    "requireModule": ["ts-node/register"],
    "format": [
      "allure-cucumberjs/reporter",
      "@cucumber/pretty-formatter"
    ],
    "formatOptions": {
      "resultsDir": "allure-results"
    },
    "paths": ["features/**/*.feature"],
    "publishQuiet": true
  }
}